{
	"format_on_save": "on",
	"hard_tabs": true,
	"preferred_line_length": 84,
	"prettier": { "allowed": false },
	"formatter": [{ "language_server": { "name": "oxfmt" } }],
	"code_actions_on_format": { "source.fixAll.oxc": true },

	"languages": {
		"TypeScript": { "language_servers": ["typescript-ls", "oxlint", "oxfmt"] },
		"JavaScript": { "language_servers": ["typescript-ls", "oxlint", "oxfmt"] }
	}
}
