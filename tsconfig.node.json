{
	"$schema": "https://json.schemastore.org/tsconfig",
	"include": ["./*.ts", "./*.js"],
	"extends": ["./tsconfig.base.json", "@tsconfig/node26/tsconfig.json"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"composite": true,
		"emitDeclarationOnly": true,
		"types": ["node26"]
	}
}
